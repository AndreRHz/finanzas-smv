/// Hechos del Estado de Resultados: una fila por empresa, año y cuenta, con la versión vigente (última publicada). Montos en miles de S/ (UPA en S/).
table 'Estado de Resultados'
	lineageTag: 2442decf-94fc-40d8-b689-058b2dad1b1f

	/// Suma del monto vigente (última versión publicada), en miles de S/, con signo contable (gastos negativos). Para matrices y cascada por cuenta: no sumar subtotales junto con su detalle (filtrar 'Cuenta Resultados'[Tipo de fila]).
	measure Monto = SUM ( 'Estado de Resultados'[Importe] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 4603d8dd-4750-45f9-ac77-90ac317a475e

	/// Monto tal como se publicó por primera vez (antes de reexpresiones), en miles de S/. Comparar con [Monto] para ver el efecto de las reexpresiones.
	measure 'Monto original' = SUM ( 'Estado de Resultados'[Importe original] )
		formatString: #,##0
		displayFolder: Base
		lineageTag: 7038b086-ff90-4290-828a-39d21c902224

	/// Ingresos de actividades ordinarias (operaciones continuadas), miles de S/, versión vigente.
	measure Ventas = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER01" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: 5b1c0aa7-5d3d-4cfe-86e7-2bbc127d66ac

	/// Costo de ventas en miles de S/ (negativo, signo contable), versión vigente.
	measure 'Costo de ventas' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER02" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: e938c594-891a-4b3f-907f-086b98ab1421

	/// Ganancia bruta = Ventas + Costo de ventas, miles de S/, versión vigente.
	measure 'Utilidad bruta' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER03" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: 5149c4c8-2f9c-462e-a3a6-610bc655c5c1

	/// Ganancia operativa (después de gastos de ventas, administración y otros operativos), miles de S/, versión vigente.
	measure 'Utilidad operativa' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER09" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: b5252064-1f04-4c26-a203-a96e026dbaea

	/// Ganancia antes de impuesto a la renta (operaciones continuadas), miles de S/, versión vigente.
	measure 'Utilidad antes de impuestos' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER21" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: 0f4a7b42-cc39-4dcb-af37-ca370c82e567

	/// Ganancia neta del ejercicio = continuadas + discontinuadas, incluye participaciones no controladoras. Miles de S/, versión vigente.
	measure 'Utilidad neta' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER25" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: 7a2035a5-8b84-4d52-9473-a22715492787

	/// Ganancia neta atribuible a los propietarios de la controladora, miles de S/. Numerador del ROE.
	measure 'Utilidad neta controladora' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER27" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: 1c5c8b4d-29ad-40a5-996a-6543116c190f

	/// Ganancia neta de operaciones continuadas (después de impuestos), miles de S/, versión vigente.
	measure 'Utilidad operaciones continuadas' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER23" )
		formatString: #,##0
		displayFolder: Continuadas vs discontinuadas
		lineageTag: 93a83119-7cbb-45d1-9163-90b0055f8831

	/// Ganancia (pérdida) de operaciones discontinuadas, neta de impuesto, miles de S/, versión vigente. Utilidad neta = continuadas + discontinuadas.
	measure 'Resultado operaciones discontinuadas' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER24" )
		formatString: #,##0
		displayFolder: Continuadas vs discontinuadas
		lineageTag: 1b1c7f47-526e-418c-854e-67f7a16261cd

	/// Utilidad bruta / Ventas (versión vigente).
	measure 'Margen bruto %' = DIVIDE ( [Utilidad bruta], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: 73de3daa-da06-42c2-8347-56568548c545

	/// Utilidad operativa / Ventas (versión vigente).
	measure 'Margen operativo %' = DIVIDE ( [Utilidad operativa], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: 9a35d517-dc3b-42e1-9acf-b69588705310

	/// Utilidad de operaciones continuadas / Ventas. Margen neto homogéneo: numerador y denominador corresponden al mismo perímetro de negocios.
	measure 'Margen continuadas %' = DIVIDE ( [Utilidad operaciones continuadas], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: 3ba77500-9770-4e9c-b972-ac1b525b7014

	/// Utilidad neta (incluye discontinuadas) / Ventas (solo continuadas). Puede distorsionarse en años con discontinuadas relevantes; ver [Margen continuadas %].
	measure 'Margen neto %' = DIVIDE ( [Utilidad neta], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: 00af3d0f-75b4-4187-b0a5-fa09c3f10ea9

	/// Gastos de ventas y distribución en miles de S/ (negativo, signo contable), versión vigente.
	measure 'Gastos de ventas' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER04" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: f9480316-375e-45c9-a0c1-02f55468671c

	/// Gastos de administración en miles de S/ (negativo, signo contable), versión vigente.
	measure 'Gastos de administración' = CALCULATE ( [Monto], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER05" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: e91eda6d-c993-4415-ac8b-d7a5deffa056

	/// Ventas tal como se publicaron por primera vez (antes de reexpresiones por operaciones discontinuadas), miles de S/. Comparar con [Ventas] (última versión publicada).
	measure 'Ventas originales' = CALCULATE ( [Monto original], REMOVEFILTERS ( 'Cuenta Resultados' ), 'Cuenta Resultados'[ID cuenta] = "ER01" )
		formatString: #,##0
		displayFolder: Resultados
		lineageTag: a28e1613-5624-4c74-81cd-b58cec3fa9d8

	/// Costo de ventas como porcentaje de las ventas (en positivo).
	measure 'Costo de ventas % ventas' = DIVIDE ( - [Costo de ventas], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: ef2186d8-7e1f-4e5d-bed2-804f41942a39

	/// Gastos de ventas y distribución como porcentaje de las ventas (en positivo).
	measure 'Gastos de ventas % ventas' = DIVIDE ( - [Gastos de ventas], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: 465b9e80-2ef1-465d-bef9-fffa4bd1c04a

	/// Gastos de administración como porcentaje de las ventas (en positivo).
	measure 'Gastos de administración % ventas' = DIVIDE ( - [Gastos de administración], [Ventas] )
		formatString: 0.0%
		displayFolder: Márgenes
		lineageTag: 7727d198-87cf-4f40-9d84-16096c524261

	/// Frase dinámica para el subtítulo de la página Resumen: descomposición DuPont del ROE del año (margen neto controladora × rotación de activos × apalancamiento) y la del año anterior. No repite los valores de las tarjetas.
	measure 'Subtítulo resumen' =
			VAR _anio = MAX ( 'Año'[Año] )
			VAR _margen = [Margen neto controladora % (DuPont)]
			VAR _rotacion = [Rotación de activos (DuPont)]
			VAR _apal = [Apalancamiento (DuPont)]
			VAR _margenAnt = CALCULATE ( [Margen neto controladora % (DuPont)], 'Año'[Año] = _anio - 1 )
			VAR _rotacionAnt = CALCULATE ( [Rotación de activos (DuPont)], 'Año'[Año] = _anio - 1 )
			VAR _apalAnt = CALCULATE ( [Apalancamiento (DuPont)], 'Año'[Año] = _anio - 1 )
			RETURN
			    IF (
			        HASONEVALUE ( 'Año'[Año] ),
			        IF (
			            ISBLANK ( _apal ),
			            _anio & " · Sin descomposición del ROE: requiere los saldos del año anterior",
			            _anio & " · El ROE se explica por margen neto × rotación de activos × apalancamiento: "
			                & FORMAT ( _margen, "0.0%" ) & " × " & FORMAT ( _rotacion, "0.00" ) & "x × " & FORMAT ( _apal, "0.00" ) & "x"
			                & IF (
			                    NOT ISBLANK ( _apalAnt ),
			                    " (" & ( _anio - 1 ) & ": " & FORMAT ( _margenAnt, "0.0%" ) & " × " & FORMAT ( _rotacionAnt, "0.00" ) & "x × " & FORMAT ( _apalAnt, "0.00" ) & "x)"
			                )
			        ),
			        "Selecciona un año"
			    )
		displayFolder: Narrativa
		lineageTag: 68e4b1dd-511a-4b72-8b63-1fb9204c92c7

	/// 1 si la cuenta de la fila es un subtotal del Estado de Resultados (Es subtotal), 0 si no. Para el formato condicional de la matriz de la página 2.
	measure 'Fila subtotal' = IF ( SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () ), 1, 0 )
		formatString: 0
		isHidden
		displayFolder: Formato
		lineageTag: e1bb211f-c059-4e2f-96ff-269f353d7761

	/// Tramo invisible bajo cada paso de variación (acumulado previo). Serie del gráfico de cascada por columnas apiladas (Paso cascada en el eje). Miles de S/.
	measure 'Cascada base' =
			VAR _k = MAX ( 'Cuenta Resultados'[Orden cascada] )
			VAR _esTotal = _k = 1 || SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () )
			VAR _delta = [Monto]
			VAR _a =
			    CALCULATE (
			        [Monto],
			        REMOVEFILTERS ( 'Cuenta Resultados' ),
			        'Cuenta Resultados'[Orden cascada] < _k,
			        NOT ISBLANK ( 'Cuenta Resultados'[Orden cascada] ),
			        'Cuenta Resultados'[Tipo de fila] = "detalle"
			    ) + 0
			VAR _b = _a + _delta
			VAR _cruza = _a * _b < 0
			RETURN
			    IF (
			        HASONEVALUE ( 'Cuenta Resultados'[Paso cascada] ) && NOT ISBLANK ( _delta ) && NOT _esTotal && NOT _cruza,
			        IF ( MIN ( _a, _b ) >= 0, MIN ( _a, _b ), MAX ( _a, _b ) )
			    )
		formatString: #,##0
		displayFolder: Cascada
		lineageTag: a50208e7-5e40-438c-8111-96d4b9fd52ee

	/// Barras de ventas y subtotales (utilidad bruta, operativa, antes de impuestos, continuadas y neta), desde cero. Serie del gráfico de cascada por columnas apiladas. Miles de S/.
	measure 'Cascada total' =
			VAR _k = MAX ( 'Cuenta Resultados'[Orden cascada] )
			VAR _esTotal = _k = 1 || SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () )
			RETURN
			    IF ( HASONEVALUE ( 'Cuenta Resultados'[Paso cascada] ) && _esTotal, [Monto] )
		formatString: #,##0
		displayFolder: Cascada
		lineageTag: 7d11cbe4-e2b2-42b7-8e81-cec80e9a50cf

	/// Tramo visible de un paso que suma. La cadena de formato muestra la variación del paso con signo. Serie del gráfico de cascada por columnas apiladas. Miles de S/.
	measure 'Cascada aumento' =
			VAR _k = MAX ( 'Cuenta Resultados'[Orden cascada] )
			VAR _esTotal = _k = 1 || SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () )
			VAR _delta = [Monto]
			VAR _a =
			    CALCULATE (
			        [Monto],
			        REMOVEFILTERS ( 'Cuenta Resultados' ),
			        'Cuenta Resultados'[Orden cascada] < _k,
			        NOT ISBLANK ( 'Cuenta Resultados'[Orden cascada] ),
			        'Cuenta Resultados'[Tipo de fila] = "detalle"
			    ) + 0
			VAR _b = _a + _delta
			VAR _cruza = _a * _b < 0
			RETURN
			    IF (
			        HASONEVALUE ( 'Cuenta Resultados'[Paso cascada] ) && NOT _esTotal && _delta > 0,
			        IF ( _cruza, MAX ( _a, _b ), IF ( MIN ( _a, _b ) >= 0, ABS ( _delta ), -ABS ( _delta ) ) )
			    )
		displayFolder: Cascada
		lineageTag: 2aa38286-7c45-4ff6-9e5b-24f061dbe405

		formatStringDefinition = """" & FORMAT ( [Monto], "+#,##0;(#,##0);0" ) & """"

	/// Tramo visible de un paso que resta. La cadena de formato muestra la variación del paso entre paréntesis. Serie del gráfico de cascada por columnas apiladas. Miles de S/.
	measure 'Cascada disminución' =
			VAR _k = MAX ( 'Cuenta Resultados'[Orden cascada] )
			VAR _esTotal = _k = 1 || SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () )
			VAR _delta = [Monto]
			VAR _a =
			    CALCULATE (
			        [Monto],
			        REMOVEFILTERS ( 'Cuenta Resultados' ),
			        'Cuenta Resultados'[Orden cascada] < _k,
			        NOT ISBLANK ( 'Cuenta Resultados'[Orden cascada] ),
			        'Cuenta Resultados'[Tipo de fila] = "detalle"
			    ) + 0
			VAR _b = _a + _delta
			VAR _cruza = _a * _b < 0
			RETURN
			    IF (
			        HASONEVALUE ( 'Cuenta Resultados'[Paso cascada] ) && NOT _esTotal && _delta < 0,
			        IF ( _cruza, MAX ( _a, _b ), IF ( MIN ( _a, _b ) >= 0, ABS ( _delta ), -ABS ( _delta ) ) )
			    )
		displayFolder: Cascada
		lineageTag: a7434fe5-68cf-40d1-af33-de699a74be69

		formatStringDefinition = """" & FORMAT ( [Monto], "+#,##0;(#,##0);0" ) & """"

	/// Parte bajo cero de un paso que suma y cruza el eje (de pérdida a utilidad). Serie del gráfico de cascada por columnas apiladas. Miles de S/.
	measure 'Cascada aumento bajo cero' =
			VAR _k = MAX ( 'Cuenta Resultados'[Orden cascada] )
			VAR _esTotal = _k = 1 || SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () )
			VAR _delta = [Monto]
			VAR _a =
			    CALCULATE (
			        [Monto],
			        REMOVEFILTERS ( 'Cuenta Resultados' ),
			        'Cuenta Resultados'[Orden cascada] < _k,
			        NOT ISBLANK ( 'Cuenta Resultados'[Orden cascada] ),
			        'Cuenta Resultados'[Tipo de fila] = "detalle"
			    ) + 0
			VAR _b = _a + _delta
			RETURN
			    IF ( HASONEVALUE ( 'Cuenta Resultados'[Paso cascada] ) && NOT _esTotal && _delta > 0 && _a * _b < 0, MIN ( _a, _b ) )
		formatString: #,##0
		displayFolder: Cascada
		lineageTag: c26f8f8e-e096-4b5b-bde7-1ab555a95b62

	/// Parte bajo cero de un paso que resta y cruza el eje (p. ej. 2021: de utilidad de operaciones continuadas a pérdida neta). Serie del gráfico de cascada por columnas apiladas. Miles de S/.
	measure 'Cascada disminución bajo cero' =
			VAR _k = MAX ( 'Cuenta Resultados'[Orden cascada] )
			VAR _esTotal = _k = 1 || SELECTEDVALUE ( 'Cuenta Resultados'[Es subtotal], FALSE () )
			VAR _delta = [Monto]
			VAR _a =
			    CALCULATE (
			        [Monto],
			        REMOVEFILTERS ( 'Cuenta Resultados' ),
			        'Cuenta Resultados'[Orden cascada] < _k,
			        NOT ISBLANK ( 'Cuenta Resultados'[Orden cascada] ),
			        'Cuenta Resultados'[Tipo de fila] = "detalle"
			    ) + 0
			VAR _b = _a + _delta
			RETURN
			    IF ( HASONEVALUE ( 'Cuenta Resultados'[Paso cascada] ) && NOT _esTotal && _delta < 0 && _a * _b < 0, MIN ( _a, _b ) )
		formatString: #,##0
		displayFolder: Cascada
		lineageTag: 6cdeacbf-dbaf-4dab-8b5e-416cd7285ffe

	/// Frase dinámica para el subtítulo de la página de cascada: de las ventas del año cuánto queda como utilidad (o pérdida) neta.
	measure 'Subtítulo cascada' =
			VAR _anio = MAX ( 'Año'[Año] )
			VAR _ventas = [Ventas]
			VAR _neta = [Utilidad neta]
			VAR _textoNeta =
			    IF (
			        _neta >= 0,
			        "quedan S/ " & FORMAT ( _neta, "#,##0" ) & " mil de utilidad neta (" & FORMAT ( [Margen neto %], "0.0%" ) & " de las ventas)",
			        "resulta una pérdida neta de S/ " & FORMAT ( - _neta, "#,##0" ) & " mil (" & FORMAT ( - [Margen neto %], "0.0%" ) & " de las ventas)"
			    )
			RETURN
			    IF (
			        HASONEVALUE ( 'Año'[Año] ),
			        _anio & " · De S/ " & FORMAT ( _ventas, "#,##0" ) & " mil en ventas " & _textoNeta,
			        "Selecciona un año"
			    )
		displayFolder: Narrativa
		lineageTag: da07f0b2-26e5-47ac-8e8c-1ccb90f867aa

